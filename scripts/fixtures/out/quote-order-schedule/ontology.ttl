@prefix : <urn:ontoforge:quote-order-schedule#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix BFO: <http://purl.obolibrary.org/obo/BFO_> .
@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix RO: <http://purl.obolibrary.org/obo/RO_> .

<urn:ontoforge:quote-order-schedule> a owl:Ontology ;
    rdfs:label "智能报价 → 订单 → 排产全链路"@zh ;
    rdfs:comment "Generated by Sloth-OntoForge-Den v2 on 2026-10-09"@en ;
    owl:imports <http://purl.obolibrary.org/obo/bfo.owl> .

# ===================== KINDS (独立存在的实体) =====================
:ONT_Customer a owl:Class ;
    rdfs:subClassOf BFO:0000030 ;
    rdfs:label "客户"@zh ;
    rdfs:comment "PI (同一性原则): customer_no"@en .

:DirectCustomer a owl:Class ;
    rdfs:subClassOf :ONT_Customer .

:ChannelCustomer a owl:Class ;
    rdfs:subClassOf :ONT_Customer .

:ONT_Product a owl:Class ;
    rdfs:subClassOf BFO:0000030 ;
    rdfs:label "产品"@zh ;
    rdfs:comment "PI (同一性原则): sku"@en .

:FinishedProduct a owl:Class ;
    rdfs:subClassOf :ONT_Product .

:SemiProduct a owl:Class ;
    rdfs:subClassOf :ONT_Product .

:ONT_Employee a owl:Class ;
    rdfs:subClassOf BFO:0000030 ;
    rdfs:label "员工"@zh ;
    rdfs:comment "PI (同一性原则): employee_no"@en .

:ONT_CNCMachine a owl:Class ;
    rdfs:subClassOf BFO:0000030 ;
    rdfs:label "CNC 机床"@zh ;
    rdfs:comment "PI (同一性原则): machine_code"@en .

:ONT_Material a owl:Class ;
    rdfs:subClassOf BFO:0000030 ;
    rdfs:label "材料"@zh ;
    rdfs:comment "PI (同一性原则): material_code"@en .

:ONT_Quotation a owl:Class ;
    rdfs:subClassOf IAO:0000030 ;
    rdfs:label "报价单"@zh ;
    rdfs:comment "PI (同一性原则): quote_no"@en .

:ONT_SalesOrder a owl:Class ;
    rdfs:subClassOf IAO:0000030 ;
    rdfs:label "销售订单"@zh ;
    rdfs:comment "PI (同一性原则): order_no"@en .

:ONT_ProductionTask a owl:Class ;
    rdfs:subClassOf IAO:0000030 ;
    rdfs:label "排产任务"@zh ;
    rdfs:comment "PI (同一性原则): task_no"@en .

:ONT_ProcessRoute a owl:Class ;
    rdfs:subClassOf IAO:0000030 ;
    rdfs:label "工艺路线"@zh ;
    rdfs:comment "PI (同一性原则): route_id + version"@en .

:ONT_CNCProcess a owl:Class ;
    rdfs:subClassOf BFO:0000015 ;
    rdfs:label "CNC 工序"@zh ;
    rdfs:comment "PI (同一性原则): process_id"@en .

:ONT_WorkCenter a owl:Class ;
    rdfs:subClassOf BFO:0000030 ;
    rdfs:label "工作中心"@zh ;
    rdfs:comment "PI (同一性原则): wc_code"@en .

# ===================== ROLES (角色) =====================
:ONT_SalesRep a owl:Class ;
    rdfs:subClassOf BFO:0000023 ;
    rdfs:label "销售"@zh ;
    rdfs:comment "依赖 relator: :ONT_QuotationRelator , :ONT_SalesOrderRelator"@en .

:ONT_Quoter a owl:Class ;
    rdfs:subClassOf BFO:0000023 ;
    rdfs:label "报价人"@zh ;
    rdfs:comment "依赖 relator: :ONT_QuotationRelator"@en .

:ONT_Approver a owl:Class ;
    rdfs:subClassOf BFO:0000023 ;
    rdfs:label "审批人"@zh ;
    rdfs:comment "依赖 relator: :ONT_ApprovalRelator"@en .

:ONT_OrderConverter a owl:Class ;
    rdfs:subClassOf BFO:0000023 ;
    rdfs:label "订单转化员"@zh ;
    rdfs:comment "依赖 relator: :ONT_SalesOrderRelator"@en .

:ONT_Planner a owl:Class ;
    rdfs:subClassOf BFO:0000023 ;
    rdfs:label "计划员"@zh ;
    rdfs:comment "依赖 relator: :ONT_ScheduleRelator"@en .

:ONT_ShopFloorMgr a owl:Class ;
    rdfs:subClassOf BFO:0000023 ;
    rdfs:label "车间主任"@zh ;
    rdfs:comment "依赖 relator: :ONT_ScheduleRelator"@en .

# ===================== RELATORS (关系实体) =====================
:ONT_InquiryRelator a owl:Class ;
    rdfs:subClassOf BFO:0000017 ;
    rdfs:label "询价关系"@zh ;
    rdfs:comment "绑定: :ONT_Customer , :ONT_SalesRep"@en .

:ONT_InquiryRelator_involves_ONT_Customer a owl:ObjectProperty ;
    rdfs:domain :ONT_InquiryRelator ;
    rdfs:range :ONT_Customer .

:ONT_InquiryRelator_involves_ONT_SalesRep a owl:ObjectProperty ;
    rdfs:domain :ONT_InquiryRelator ;
    rdfs:range :ONT_SalesRep .

:ONT_QuotationRelator a owl:Class ;
    rdfs:subClassOf BFO:0000017 ;
    rdfs:label "报价关系"@zh ;
    rdfs:comment "绑定: :ONT_Customer , :ONT_Quoter , :ONT_Quotation"@en .

:ONT_QuotationRelator_involves_ONT_Customer a owl:ObjectProperty ;
    rdfs:domain :ONT_QuotationRelator ;
    rdfs:range :ONT_Customer .

:ONT_QuotationRelator_involves_ONT_Quoter a owl:ObjectProperty ;
    rdfs:domain :ONT_QuotationRelator ;
    rdfs:range :ONT_Quoter .

:ONT_QuotationRelator_involves_ONT_Quotation a owl:ObjectProperty ;
    rdfs:domain :ONT_QuotationRelator ;
    rdfs:range :ONT_Quotation .

:ONT_ApprovalRelator a owl:Class ;
    rdfs:subClassOf BFO:0000017 ;
    rdfs:label "审批关系"@zh ;
    rdfs:comment "绑定: :ONT_Quotation , :ONT_Approver"@en .

:ONT_ApprovalRelator_involves_ONT_Quotation a owl:ObjectProperty ;
    rdfs:domain :ONT_ApprovalRelator ;
    rdfs:range :ONT_Quotation .

:ONT_ApprovalRelator_involves_ONT_Approver a owl:ObjectProperty ;
    rdfs:domain :ONT_ApprovalRelator ;
    rdfs:range :ONT_Approver .

:ONT_QuoteItemRelator a owl:Class ;
    rdfs:subClassOf BFO:0000017 ;
    rdfs:label "报价项关系"@zh ;
    rdfs:comment "绑定: :ONT_Quotation , :ONT_Product"@en .

:ONT_QuoteItemRelator_involves_ONT_Quotation a owl:ObjectProperty ;
    rdfs:domain :ONT_QuoteItemRelator ;
    rdfs:range :ONT_Quotation .

:ONT_QuoteItemRelator_involves_ONT_Product a owl:ObjectProperty ;
    rdfs:domain :ONT_QuoteItemRelator ;
    rdfs:range :ONT_Product .

:ONT_SalesOrderRelator a owl:Class ;
    rdfs:subClassOf BFO:0000017 ;
    rdfs:label "订单关系"@zh ;
    rdfs:comment "绑定: :ONT_Quotation , :ONT_OrderConverter , :ONT_SalesOrder"@en .

:ONT_SalesOrderRelator_involves_ONT_Quotation a owl:ObjectProperty ;
    rdfs:domain :ONT_SalesOrderRelator ;
    rdfs:range :ONT_Quotation .

:ONT_SalesOrderRelator_involves_ONT_OrderConverter a owl:ObjectProperty ;
    rdfs:domain :ONT_SalesOrderRelator ;
    rdfs:range :ONT_OrderConverter .

:ONT_SalesOrderRelator_involves_ONT_SalesOrder a owl:ObjectProperty ;
    rdfs:domain :ONT_SalesOrderRelator ;
    rdfs:range :ONT_SalesOrder .

:ONT_ScheduleRelator a owl:Class ;
    rdfs:subClassOf BFO:0000017 ;
    rdfs:label "排产关系"@zh ;
    rdfs:comment "绑定: :ONT_SalesOrder , :ONT_Planner , :ONT_ProductionTask"@en .

:ONT_ScheduleRelator_involves_ONT_SalesOrder a owl:ObjectProperty ;
    rdfs:domain :ONT_ScheduleRelator ;
    rdfs:range :ONT_SalesOrder .

:ONT_ScheduleRelator_involves_ONT_Planner a owl:ObjectProperty ;
    rdfs:domain :ONT_ScheduleRelator ;
    rdfs:range :ONT_Planner .

:ONT_ScheduleRelator_involves_ONT_ProductionTask a owl:ObjectProperty ;
    rdfs:domain :ONT_ScheduleRelator ;
    rdfs:range :ONT_ProductionTask .

# ===================== QUALITIES (可量化属性) =====================
:ONT_UnitPrice a owl:DatatypeProperty ;
    rdfs:label "单价"@zh ;
    rdfs:domain :ONT_Product ;
    rdfs:range xsd:decimal .

:ONT_Quantity__ONT_QuoteItemRelator a owl:DatatypeProperty ;
    rdfs:label "数量 (在 ONT_QuoteItemRelator 上)"@zh ;
    rdfs:domain :ONT_QuoteItemRelator ;
    rdfs:range xsd:integer .

:ONT_Quantity__ONT_SalesOrderRelator a owl:DatatypeProperty ;
    rdfs:label "数量 (在 ONT_SalesOrderRelator 上)"@zh ;
    rdfs:domain :ONT_SalesOrderRelator ;
    rdfs:range xsd:integer .

:ONT_DiscountRate a owl:DatatypeProperty ;
    rdfs:label "折扣"@zh ;
    rdfs:domain :ONT_Quotation ;
    rdfs:range xsd:decimal .

:ONT_ValidityDays a owl:DatatypeProperty ;
    rdfs:label "有效期天数"@zh ;
    rdfs:domain :ONT_Quotation ;
    rdfs:range xsd:integer .

:ONT_TotalAmount__ONT_Quotation a owl:DatatypeProperty ;
    rdfs:label "总额 (在 ONT_Quotation 上)"@zh ;
    rdfs:domain :ONT_Quotation ;
    rdfs:range xsd:decimal .

:ONT_TotalAmount__ONT_SalesOrder a owl:DatatypeProperty ;
    rdfs:label "总额 (在 ONT_SalesOrder 上)"@zh ;
    rdfs:domain :ONT_SalesOrder ;
    rdfs:range xsd:decimal .

:ONT_DeliveryDate a owl:DatatypeProperty ;
    rdfs:label "交期"@zh ;
    rdfs:domain :ONT_SalesOrder ;
    rdfs:range xsd:date .

:ONT_CycleTime a owl:DatatypeProperty ;
    rdfs:label "节拍 (秒)"@zh ;
    rdfs:domain :ONT_CNCProcess ;
    rdfs:range xsd:integer .

:ONT_MachineHourRate a owl:DatatypeProperty ;
    rdfs:label "机时费 (元/小时)"@zh ;
    rdfs:domain :ONT_CNCMachine ;
    rdfs:range xsd:decimal .

:ONT_PlannedStart a owl:DatatypeProperty ;
    rdfs:label "计划开始"@zh ;
    rdfs:domain :ONT_ProductionTask ;
    rdfs:range xsd:dateTime .

:ONT_PlannedEnd a owl:DatatypeProperty ;
    rdfs:label "计划结束"@zh ;
    rdfs:domain :ONT_ProductionTask ;
    rdfs:range xsd:dateTime .

# ===================== PHASES (状态枚举) =====================
:ONT_Quotation_Phase a owl:Class ;
    rdfs:label "ONT_Quotation 的状态枚举"@zh .

:ONT_Quotation_Draft a owl:NamedIndividual , :ONT_Quotation_Phase ;
    rdfs:label "Draft"@en .
:ONT_Quotation_Pricing a owl:NamedIndividual , :ONT_Quotation_Phase ;
    rdfs:label "Pricing"@en .
:ONT_Quotation_PendingApproval a owl:NamedIndividual , :ONT_Quotation_Phase ;
    rdfs:label "PendingApproval"@en .
:ONT_Quotation_Approved a owl:NamedIndividual , :ONT_Quotation_Phase ;
    rdfs:label "Approved"@en .
:ONT_Quotation_Rejected a owl:NamedIndividual , :ONT_Quotation_Phase ;
    rdfs:label "Rejected"@en .
:ONT_Quotation_Sent a owl:NamedIndividual , :ONT_Quotation_Phase ;
    rdfs:label "Sent"@en .
:ONT_Quotation_Expired a owl:NamedIndividual , :ONT_Quotation_Phase ;
    rdfs:label "Expired"@en .
:ONT_Quotation_Accepted a owl:NamedIndividual , :ONT_Quotation_Phase ;
    rdfs:label "Accepted"@en .

:ONT_Quotation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :has_phase ;
    owl:allValuesFrom :ONT_Quotation_Phase
] .

:ONT_SalesOrder_Phase a owl:Class ;
    rdfs:label "ONT_SalesOrder 的状态枚举"@zh .

:ONT_SalesOrder_Draft a owl:NamedIndividual , :ONT_SalesOrder_Phase ;
    rdfs:label "Draft"@en .
:ONT_SalesOrder_Confirmed a owl:NamedIndividual , :ONT_SalesOrder_Phase ;
    rdfs:label "Confirmed"@en .
:ONT_SalesOrder_InProduction a owl:NamedIndividual , :ONT_SalesOrder_Phase ;
    rdfs:label "InProduction"@en .
:ONT_SalesOrder_Shipped a owl:NamedIndividual , :ONT_SalesOrder_Phase ;
    rdfs:label "Shipped"@en .
:ONT_SalesOrder_Closed a owl:NamedIndividual , :ONT_SalesOrder_Phase ;
    rdfs:label "Closed"@en .

:ONT_SalesOrder rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :has_phase ;
    owl:allValuesFrom :ONT_SalesOrder_Phase
] .

:ONT_ProductionTask_Phase a owl:Class ;
    rdfs:label "ONT_ProductionTask 的状态枚举"@zh .

:ONT_ProductionTask_Queued a owl:NamedIndividual , :ONT_ProductionTask_Phase ;
    rdfs:label "Queued"@en .
:ONT_ProductionTask_Released a owl:NamedIndividual , :ONT_ProductionTask_Phase ;
    rdfs:label "Released"@en .
:ONT_ProductionTask_InProgress a owl:NamedIndividual , :ONT_ProductionTask_Phase ;
    rdfs:label "InProgress"@en .
:ONT_ProductionTask_Completed a owl:NamedIndividual , :ONT_ProductionTask_Phase ;
    rdfs:label "Completed"@en .
:ONT_ProductionTask_Aborted a owl:NamedIndividual , :ONT_ProductionTask_Phase ;
    rdfs:label "Aborted"@en .

:ONT_ProductionTask rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :has_phase ;
    owl:allValuesFrom :ONT_ProductionTask_Phase
] .

# ===================== BFO RELATIONS =====================
:ONT_QuoteItemRelator rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty RO:0000052 ;
    owl:someValuesFrom :ONT_Quotation
] .

:ONT_OrderItemRelator rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty RO:0000052 ;
    owl:someValuesFrom :ONT_SalesOrder
] .

:ONT_CustomerCreditLevel rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty RO:0000052 ;
    owl:someValuesFrom :ONT_Customer
] .

:ONT_MachineStatus rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty RO:0000052 ;
    owl:someValuesFrom :ONT_CNCMachine
] .

:ONT_SalesRep rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty RO:0000056 ;
    owl:someValuesFrom :ONT_QuotationRelator
] .

:ONT_SubmitQuote rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty RO:0000057 ;
    owl:someValuesFrom :ONT_Quoter
] .

:ONT_SalesOrder rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty BFO:0000062 ;
    owl:someValuesFrom :ONT_Quotation
] .
